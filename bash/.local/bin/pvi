#!/usr/bin/env bash

if ( echo $EDITOR | CLICOLOR=1 grep -v vim > /dev/null ); then
  if ( command -v vim > /dev/null ); then
    EDITOR=vim
  elif ( command -v nvim > /dev/null ); then
    EDITOR=nvim
  else
    exit 1
  fi
fi

if ( command -v mktemp > /dev/null ); then
  tmpfile=$(mktemp -t pvi$$)
else
  tmpfile=${HOME}/pvi$$
fi

if [ ! -t 0 ]; then
  cat > $tmpfile
fi

trap "rm ${tmpfile}" EXIT

command $EDITOR \
  -c "set noswapfile" \
  -c "silent! set viminfofile=NONE" \
  -c "silent! set shadafile=NONE" \
  -c "nn <buffer> <CR> :.w! % <Bar> q!<CR>" \
  -c "nn <buffer> <C-c> :cq<CR>" \
  -- $tmpfile < /dev/tty > /dev/tty || exit

cat $tmpfile
