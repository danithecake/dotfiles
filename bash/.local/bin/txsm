#!/usr/bin/env bash

if ( ! command -v tmux > /dev/null ); then
  echo "executable 'tmux' is required but wasn't found" >&2
  exit 1
fi

TMUX_SERV_DIR=$(find ${TMUX_TMPDIR:-/tmp}/* -maxdepth 1 -type d -name "tmux-*" 2>/dev/null | head -1)

function has-tmux-session {
  return $(tmux -L "$1" ls 2>/dev/null | grep "$1" >/dev/null && true || false)
}

function attach-tmux-session {
  tmux -L "$1" $(test -n "$TMUX" && echo "switch-client" || echo "attach") -t "$1"
}

if [ "$1" == "list" ]; then
  test ! -d "${TMUX_SERV_DIR}" && exit 0

  for file in ${TMUX_SERV_DIR}/*; do
    fname=$(awk -F '/' '{print $NF}' <<<"$file")

    has-tmux-session "$fname" && printf "%s\n" $fname
  done
  exit 0
fi

if [ -z "$2" ]; then
  SESNAME=$(printf "%s\n" ${TMUX_SERV_DIR}/* | awk 'END {print NR}')
elif [ -f "$2" ]; then
  SESNAME=$(awk -F '.' '{sub(/\//, "", $0); print $(NF-1)}' <<<"$2")
else
  SESNAME="$2"
fi

if [ "$1" == "attach" ]; then
  test -z $SESNAME && ( echo "session name is required" >&2 ; exit 1 )

  if ( has-tmux-session $SESNAME ); then
    attach-tmux-session $SESNAME
    exit 0
  fi

  echo "there is no '${2}' session running" >&2
  exit 1
fi

if [ "$1" == "stop" ]; then
  test -z $SESNAME && ( echo "session name is required" >&2 ; exit 1 )

  if ( has-tmux-session $SESNAME ); then
    tmux -L $SESNAME kill-session -t $SESNAME
    rm "${TMUX_SERV_DIR}/${SESNAME}" 2>/dev/null
    exit 0
  fi

  echo "there is no '${SESNAME}' session running" >&2
  exit 1
fi

if [ "$1" != "start" ]; then
  echo "Usage: txsm start [name]"
  echo "       txsm stop name"
  echo "       txsm attach name"
  echo "       txsm list"
  exit 0
fi

if ( has-tmux-session "$SESNAME" ); then
  echo "session '${SESNAME}' has already been started" >&2
  exit 1
fi

SESROOT=$(pwd)

while read file; do
  source ${file} TMUX_CMDS && break
  source ${file}.sh TMUX_CMDS && break
done 2>/dev/null <<FILES
  ${SESNAME}
  ${TXSM_CONFIG}/${SESNAME}
  ${XDG_CONFIG_HOME}/txsm/${SESNAME}
  ${HOME}/.config/txsm/${SESNAME}
FILES

export TXSM=1

prev_term_title=$(ps -o comm= -p $$ | sed 's/^-//')

# tmux -L $SESNAME -C new -s $SESNAME -c $SESROOT >/dev/null <<CMDS
tmux -L $SESNAME new-session -d -s $SESNAME -c $SESROOT >/dev/null
tmux -L $SESNAME -C >/dev/null <<CMDS
  attach-session -t $SESNAME
  set-option -g exit-empty on
  set-option -g set-titles on
  set-option -F set-titles-string "#S"
  set-hook -g session-closed 'run-shell "rm ${TMUX_SERV_DIR}/${SESNAME}"'
#  set-hook -g client-detached 'run-shell "bash -ic \"term-title ${prev_term_title}\""'
  ${TMUX_CMDS}
CMDS

attach-tmux-session "$SESNAME"

exit 0
