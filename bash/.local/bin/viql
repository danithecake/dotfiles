#!/usr/bin/env bash

if ( echo $EDITOR | CLICOLOR=1 grep -v vim > /dev/null ); then
  if ( command -v vim > /dev/null ); then
    EDITOR=vim
  elif ( command -v nvim > /dev/null ); then
    EDITOR=nvim
  else
    exit 1
  fi
fi

if ( command -v mktemp > /dev/null ); then
  tmpfile=$(mktemp -t viqi$$)
else
  tmpfile=${HOME}/viqi$$
fi

if [ -t 0 ]; then
  cat > $tmpfile
fi

if [ -e $1 ]; then
  cat $1 > $tmpfile
fi

trap "rm ${tmpfile}" EXIT


if [ ! -s $tmpfile ]; then
  exit 1
fi

command $EDITOR $tmpfile -c "cbuffer | cwindow | bw! 1" || exit
